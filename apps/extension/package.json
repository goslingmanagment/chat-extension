{
  "name": "@cg/extension",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "ChatGoose \u0434\u043b\u044f ChatSpace \u2014 Firefox MV3 extension (WXT entry points, manifest, composition roots).",
  "scripts": {
    "build": "cd ../.. && wxt zip apps/extension -b firefox --mv3",
    "build:test": "cd ../.. && CG_TEST_HOSTS=1 wxt zip apps/extension -b firefox --mv3",
    "build:lazy": "vite build -c lazy/vite.config.ts"
  },
  "dependencies": {
    "@cg/contracts": "workspace:*",
    "@cg/core": "workspace:*",
    "@cg/host-chatspace": "workspace:*",
    "@cg/hub": "workspace:*",
    "@cg/platform": "workspace:*",
    "@cg/ui": "workspace:*",
    "@preact/signals": "2.11.3",
    "preact": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "wxt": "0.21.4"
  }
}
