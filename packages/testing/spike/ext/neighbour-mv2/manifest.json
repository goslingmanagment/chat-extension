{
  "manifest_version": 2,
  "name": "cg-spike-neighbour-mv2",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "nb2@cg-spike.test" } },
  "permissions": ["http://fansly.test/*", "http://apiv3.fansly.test/*"],
  "background": { "scripts": ["nb-bg.js"], "persistent": false },
  "content_scripts": [{ "matches": ["http://fansly.test/*"], "js": ["cs.js"], "run_at": "document_idle" }]
}
