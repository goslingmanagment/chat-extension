{
  "manifest_version": 3,
  "name": "cg-spike-perm",
  "version": "__VERSION__",
  "browser_specific_settings": { "gecko": { "id": "perm@cg-spike.test", "strict_min_version": "142.0" } },
  "background": { "scripts": ["bg.js"] },
  "permissions": ["scripting", "storage"],
  "optional_host_permissions": ["http://fansly.test/*", "http://apiv3.fansly.test/*"],
  "optional_permissions": ["webRequest"],
  "content_security_policy": { "extension_pages": "script-src 'self'" },
  "web_accessible_resources": [{ "resources": ["lazy/*"], "matches": ["http://fansly.test/*"] }]
}
