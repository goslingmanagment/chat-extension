{
  "name": "@cg/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./app-client": "./src/scenarios/app-client/index.ts",
    "./hub": "./src/scenarios/hub/index.ts",
    "./fake-hub": "./src/fake-hub/index.ts",
    "./host": "./src/scenarios/host/index.ts",
    "./stand": "./src/stand/index.ts"
  },
  "dependencies": {
    "@cg/contracts": "workspace:*",
    "@cg/core": "workspace:*",
    "@cg/host-chatspace": "workspace:*",
    "@cg/hub": "workspace:*",
    "@cg/platform": "workspace:*",
    "@cg/ui": "workspace:*",
    "@preact/signals": "2.11.3",
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/mocha": "10.0.10",
    "@types/ws": "8.18.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "pinia": "3.0.4",
    "tsx": "4.23.15",
    "vite": "8.3.2",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "webdriverio": "9.32.0",
    "ws": "8.22.0"
  },
  "scripts": {
    "build:stand": "vite build --config fixture-chatspace.vite.config.ts",
    "stand": "pnpm build:stand && tsx src/stand-cli.ts",
    "e2e": "pnpm build:stand && pnpm build:gallery && pnpm build:pages && wdio run e2e/wdio.conf.ts",
    "perf": "pnpm build:stand && wdio run e2e/wdio.conf.ts --spec e2e/perf/perf-probe.e2e.ts",
    "build:gallery": "vite build --config kit-gallery.vite.config.ts && vite build --config dock-gallery.vite.config.ts && vite build --config boards-gallery.vite.config.ts",
    "build:pages": "vite build --config pages-gallery.vite.config.ts",
    "gallery": "pnpm build:stand && pnpm build:gallery && pnpm build:pages && tsx src/stand-cli.ts"
  }
}
