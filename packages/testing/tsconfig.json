{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework"
    ],
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": [
    "src",
    "e2e",
    "fixture-chatspace.vite.config.ts",
    "fixture-fansly.vite.config.ts",
    "fixture-telegram.vite.config.ts",
    "fansly-neighbor.vite.config.ts",
    "kit-gallery.vite.config.ts",
    "dock-gallery.vite.config.ts",
    "boards-gallery.vite.config.ts",
    "pages-gallery.vite.config.ts"
  ],
  "exclude": [
    "e2e/see/scratch"
  ],
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../core"
    },
    {
      "path": "../platform"
    },
    {
      "path": "../hub"
    },
    {
      "path": "../host-kit"
    },
    {
      "path": "../host-chatspace"
    },
    {
      "path": "../host-fansly"
    },
    {
      "path": "../fansly-api"
    },
    {
      "path": "../ui"
    },
    {
      "path": "./fixture-chatspace"
    },
    {
      "path": "./fixture-fansly"
    },
    {
      "path": "./fixture-telegram"
    }
  ]
}
